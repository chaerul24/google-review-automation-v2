# AutoBotix Google Review Automation Configuration

# Flask Secret Key
SECRET_KEY=your_random_secret_key_here

# Dashboard & API Authentication
APP_USERNAME=admin
APP_PASSWORD=your_secure_password_here

# Public URL (for production reverse proxy)
PUBLIC_BASE_URL=https://autobotix.my.id

# AI Generation (Google AI Studio Gemini API Key)
GEMINI_API_KEY=your_gemini_api_key_here

# App Environment (development / production)
APP_ENV=production
